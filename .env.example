# ==============================================================================
# University Bus Tracking System — Environment Variables Example
# ==============================================================================
# Copy this file to `.env` for local configuration, or provide these environment
# variables in your production environment (e.g., Docker, AWS, Render, Heroku, or systemd).
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Active Spring Profile (prod for production; leave blank/default for development)
# In production, activating 'prod' enables application-prod.properties with validate ddl-auto.
SPRING_PROFILES_ACTIVE=prod

# Application Server Port (Defaults to 5000 if omitted)
PORT=5000

# ------------------------------------------------------------------------------
# Database Configuration (MySQL)
# In development: defaults to localhost:3306/university_bus_db, root/root
# In production (prod profile): REQUIRED via environment variables. Startup fails if missing.
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/university_bus_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=your_database_username
DB_PASSWORD=your_secure_database_password_here

# ------------------------------------------------------------------------------
# JWT Configuration
# In development: a default fallback key is available for quick local runs.
# In production (prod profile): REQUIRED. Must be a cryptographically strong 256-bit Base64 key.
# Generate using: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=your_base64_encoded_256_bit_secret_key_here
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# File Upload Directory
# In development: defaults to ./uploads (relative to backend folder)
# In production (prod profile): REQUIRED. Specify an absolute, persistent path, e.g.:
#   Linux/Docker: /var/app/uploads
#   Windows: C:/app/uploads
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# Media Base URL (Optional)
# Leave empty for relative paths (/uploads/...) or specify CDN / domain, e.g.:
#   MEDIA_BASE_URL=https://api.yourdomain.com
MEDIA_BASE_URL=

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# In development: defaults to http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# In production (prod profile): REQUIRED. Specify trusted frontend domains (comma-separated):
#   APP_CORS_ALLOWED_ORIGINS=https://bus.university.edu,https://admin.bus.university.edu
# ------------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Initial Administrator Bootstrap (Optional, one-time setup if zero admins exist)
# Only executed when countByRole(Role.ADMIN) == 0. Will NEVER overwrite or reset existing admins.
# Provide once during initial launch, then remove or unset after first startup:
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
