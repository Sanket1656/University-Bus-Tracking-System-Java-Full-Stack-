# ==============================================================================
# Frontend Production Environment Variables Template
# ==============================================================================
# For production deployments, copy this file to:
#   `frontend/.env.production`
# or define `VITE_API_URL` directly in your CI/CD build runner / deployment platform.
#
# Vite will automatically inject variables prefixed with `VITE_` during:
#   `npm run build`
#
# Backend API Base URL (Must include /api and match your deployed backend domain)
VITE_API_URL=https://api.yourdomain.com/api

# Optional: Custom OSRM routing server URL (default: https://router.project-osrm.org)
# VITE_OSRM_URL=https://router.project-osrm.org
